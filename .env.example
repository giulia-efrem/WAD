# MongoDB connection string (local or Atlas mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/morsel
# Long random string used to sign login cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=3000
# Order tracking speed. 30 means one simulated minute lasts two seconds. 1 is real time.
DEMO_SPEED=30
# Optional: Unsplash Access Key (https://unsplash.com/developers) for npm run photos and /admin/photos.
# It stays on the server; the browser never calls Unsplash.
UNSPLASH_ACCESS_KEY=
