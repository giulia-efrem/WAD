# Copy this file to .env and fill it in. Settings left empty use the default shown.

# Required. MongoDB connection string (local mongodb://127.0.0.1:27017/morsel or Atlas mongodb+srv://...)
MONGODB_URI=
# Required. Long random string used to sign login cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Port the server listens on. Default 3000.
PORT=
# production turns on secure cookies and HTTPS-only headers. Leave empty for local development.
NODE_ENV=
# Order tracking speed. 30 (default) means one simulated minute lasts two seconds. 1 is real time.
DEMO_SPEED=
# true adds a "Demo accounts" section to the login window: one click logs in as the demo
# customer, a restaurant partner, a courier or the admin. Leave it off anywhere public.
DEMO_MODE=

# Optional: Unsplash Access Key (https://unsplash.com/developers) for npm run photos and /admin/photos.
# It stays on the server; the browser never calls Unsplash. Not needed to run the app or the seed.
UNSPLASH_ACCESS_KEY=
# How many Unsplash requests npm run photos may make per hour. Default 40.
PHOTOS_PER_HOUR=

# Folders. Default uploads/ and seed/ in the project.
UPLOADS_DIR=
PHOTO_FILES_DIR=

# Rate limits (requests per window). Defaults: sign-up 10, password reset 10, contact form 8.
SIGNUP_LIMIT=
RESET_LIMIT=
CONTACT_LIMIT=

# npm run screenshots: address of the running app (default http://localhost:PORT) and browser
# (default msedge; chrome also works).
BASE_URL=
PW_CHANNEL=

# Tests. Database, whose name must end in _test (default morsel_test next to MONGODB_URI), test server port
# (default 3100) and browser for the e2e tests (default msedge).
TEST_MONGODB_URI=
TEST_PORT=
MORSEL_TEST_BROWSER=
